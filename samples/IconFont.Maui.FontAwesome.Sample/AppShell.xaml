<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="IconFont.Maui.FontAwesome.Sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:IconFont.Maui.FontAwesome.Sample"
    Title="Font Awesome Icons">

    <TabBar>
        <ShellContent
            Title="Solid"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="SolidIcons" />
        <ShellContent
            Title="Regular"
            ContentTemplate="{DataTemplate local:RegularIconsPage}"
            Route="RegularIcons" />
        <ShellContent
            Title="Brands"
            ContentTemplate="{DataTemplate local:BrandsIconsPage}"
            Route="BrandsIcons" />
    </TabBar>

</Shell>
